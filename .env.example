# Discord-бот (index.js)
DISCORD_TOKEN=

# Telegram-бот (telegram-bot.js)
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Канал-приёмник: @имя_канала (публичный) или -1001234567890 (приватный)
TELEGRAM_CHANNEL_ID=
# forward — с пометкой «Переслано от», copy — без неё (автора бот подпишет сам)
TELEGRAM_FORWARD_MODE=forward
# 1 — бот дополнительно присылает то же медиа обратно в чат
TELEGRAM_ECHO_BACK=0
